# Server Configuration
PROJECT_NAME="Developer Assessment & Coding Platform API"
API_V1_STR="/api/v1"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database (Default: Async SQLite, can switch to PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/assessment_db)
DATABASE_URL="sqlite+aiosqlite:///./dev.db"

# Security & JWT Tokens
JWT_SECRET_KEY="super-secret-key-change-this-in-production-exam-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Code Execution Sandbox Defaults
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=128
MAX_OUTPUT_BUFFER_BYTES=65536
